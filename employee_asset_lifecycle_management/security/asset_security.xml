
<odoo>
    <data noupdate="1">

        <!-- =====================================================
             SECURITY CATEGORY
        ====================================================== -->

        <record id="module_asset_category" model="ir.module.category">
            <field name="name">Asset Management</field>
            <field name="sequence">25</field>
        </record>


        <!-- =====================================================
             SECURITY GROUPS
        ====================================================== -->

        <!-- Employee -->
        <record id="group_asset_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_asset_category"/>
            <field name="comment">
                Can view their own assigned assets and submit repair requests.
            </field>
        </record>

        <!-- Asset Manager -->
        <record id="group_asset_manager" model="res.groups">
            <field name="name">Asset Manager</field>
            <field name="category_id" ref="module_asset_category"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_asset_employee'))]"/>
            <field name="comment">
                Can assign, return, repair, and dispose assets.
            </field>
        </record>

        <!-- HR Manager / Full Admin -->
        <record id="group_asset_hr_manager" model="res.groups">
            <field name="name">HR / Full Admin</field>
            <field name="category_id" ref="module_asset_category"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_asset_manager')),
                          (4, ref('hr.group_hr_manager'))]"/>
            <field name="comment">
                Full access to all asset management operations.
            </field>
        </record>


        <!-- =====================================================
             EMPLOYEE RECORD RULES
        ====================================================== -->

        <!-- Employees can read only their own assignments -->
        <record id="rule_asset_assignment_employee" model="ir.rule">
            <field name="name">
                Asset Assignment: Employee sees own records
            </field>
            <field name="model_id" ref="model_asset_assignment"/>
            <field name="groups"
                   eval="[(4, ref('group_asset_employee'))]"/>
            <field name="domain_force">
                [('employee_id.user_id', '=', user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Employees can access their own repair requests -->
        <record id="rule_asset_repair_employee" model="ir.rule">
            <field name="name">
                Asset Repair: Employee sees own records
            </field>
            <field name="model_id" ref="model_asset_repair"/>
            <field name="groups"
                   eval="[(4, ref('group_asset_employee'))]"/>
            <field name="domain_force">
                [('requested_by.user_id', '=', user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>


        <!-- =====================================================
             ASSET MANAGER RECORD RULES
        ====================================================== -->

        <!-- Managers can access all assignments -->
        <record id="rule_asset_assignment_manager" model="ir.rule">
            <field name="name">
                Asset Assignment: Manager full access
            </field>
            <field name="model_id" ref="model_asset_assignment"/>
            <field name="groups"
                   eval="[(4, ref('group_asset_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Managers can access all repair requests -->
        <record id="rule_asset_repair_manager" model="ir.rule">
            <field name="name">
                Asset Repair: Manager full access
            </field>
            <field name="model_id" ref="model_asset_repair"/>
            <field name="groups"
                   eval="[(4, ref('group_asset_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
