
<odoo>

    <!-- =========================================================
         ASSET REPAIR — FORM VIEW
    ========================================================== -->
    <record id="view_asset_repair_form" model="ir.ui.view">
        <field name="name">asset.repair.form</field>
        <field name="model">asset.repair</field>
        <field name="arch" type="xml">
            <form string="Repair Request">

                <header>
                    <button name="action_set_in_progress"
                            string="Start Repair"
                            type="object"
                            class="oe_highlight"
                            invisible="status != 'new'"/>

                    <button name="action_set_done"
                            string="Mark as Done"
                            type="object"
                            class="oe_highlight"
                            invisible="status != 'in_progress'"/>

                    <button name="action_set_rejected"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="status in ['done', 'rejected']"/>

                    <button name="action_reset_to_new"
                            string="Reset to New"
                            type="object"
                            invisible="status != 'rejected'"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="new,in_progress,done"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Request Details">
                            <field name="asset_id"/>
                            <field name="requested_by"/>
                            <field name="request_date"/>
                            <field name="asset_status" readonly="1"/>
                            <field name="asset_condition" readonly="1"/>
                        </group>

                        <group string="Repair Info">
                            <field name="repair_cost"/>
                            <field name="completion_date" readonly="1"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Issue Description">
                            <field name="issue_description"
                                   placeholder="Describe the issue in detail..."/>
                        </page>

                        <page string="Technician Notes">
                            <field name="technician_notes"
                                   placeholder="Technician's remarks and repair notes..."/>
                        </page>

                    </notebook>

                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <!-- =========================================================
         ASSET REPAIR — TREE VIEW
    ========================================================== -->
    <record id="view_asset_repair_tree" model="ir.ui.view">
        <field name="name">asset.repair.tree</field>
        <field name="model">asset.repair</field>
        <field name="arch" type="xml">

            <tree string="Repair Requests"
                  decoration-success="status == 'done'"
                  decoration-danger="status == 'rejected'"
                  decoration-warning="status == 'in_progress'"
                  decoration-muted="status == 'rejected'">

                <field name="name"/>
                <field name="asset_id"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="repair_cost"/>
                <field name="completion_date"/>
                <field name="status"/>

            </tree>
        </field>
    </record>


    <!-- =========================================================
         ASSET REPAIR — KANBAN VIEW
    ========================================================== -->
    <record id="view_asset_repair_kanban" model="ir.ui.view">
        <field name="name">asset.repair.kanban</field>
        <field name="model">asset.repair</field>
        <field name="arch" type="xml">

            <kanban default_group_by="status"
                    class="o_kanban_small_column">

                <field name="name"/>
                <field name="asset_id"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="repair_cost"/>
                <field name="status"/>

                <templates>
                    <t t-name="kanban-box">

                        <div class="oe_kanban_global_click oe_kanban_card">

                            <div class="oe_kanban_content">

                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <ul>

                                        <li>
                                            Asset:
                                            <field name="asset_id"/>
                                        </li>

                                        <li>
                                            Requested By:
                                            <field name="requested_by"/>
                                        </li>

                                        <li>
                                            Date:
                                            <field name="request_date"/>
                                        </li>

                                        <li>
                                            Cost:
                                            <field name="repair_cost"/>
                                        </li>

                                    </ul>
                                </div>

                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>


    <!-- =========================================================
         ASSET REPAIR — GRAPH VIEW
    ========================================================== -->
    <record id="view_asset_repair_graph" model="ir.ui.view">
        <field name="name">asset.repair.graph</field>
        <field name="model">asset.repair</field>
        <field name="arch" type="xml">

            <graph string="Repair Overview" type="bar">
                <field name="status" type="row"/>
                <field name="repair_cost" type="measure"/>
            </graph>

        </field>
    </record>


    <!-- =========================================================
         ASSET REPAIR — SEARCH VIEW
    ========================================================== -->
    <record id="view_asset_repair_search" model="ir.ui.view">
        <field name="name">asset.repair.search</field>
        <field name="model">asset.repair</field>
        <field name="arch" type="xml">

            <search string="Search Repair Requests">

                <field name="name"/>
                <field name="asset_id"/>
                <field name="requested_by"/>

                <!-- Status Filters -->
                <filter name="filter_new"
                        string="New"
                        domain="[('status', '=', 'new')]"/>

                <filter name="filter_in_progress"
                        string="In Progress"
                        domain="[('status', '=', 'in_progress')]"/>

                <filter name="filter_done"
                        string="Done"
                        domain="[('status', '=', 'done')]"/>

                <filter name="filter_rejected"
                        string="Rejected"
                        domain="[('status', '=', 'rejected')]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">

                    <filter name="group_status"
                            string="Status"
                            context="{'group_by': 'status'}"/>

                    <filter name="group_asset"
                            string="Asset"
                            context="{'group_by': 'asset_id'}"/>

                    <filter name="group_requested_by"
                            string="Requested By"
                            context="{'group_by': 'requested_by'}"/>

                    <filter name="group_month"
                            string="Month"
                            context="{'group_by': 'request_date:month'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- =========================================================
         ASSET REPAIR — ACTION
    ========================================================== -->
    <record id="action_asset_repair"
            model="ir.actions.act_window">

        <field name="name">Repair Requests</field>
        <field name="res_model">asset.repair</field>
        <field name="view_mode">tree,kanban,form,graph</field>

        <field name="search_view_id"
               ref="view_asset_repair_search"/>

        <field name="context">
            {'search_default_filter_new': 1}
        </field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No repair requests found.
            </p>
        </field>

    </record>

</odoo>
