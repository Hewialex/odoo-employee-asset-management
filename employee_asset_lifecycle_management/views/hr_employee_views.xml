
<odoo>

    <!-- =========================================================
         HR EMPLOYEE — INHERITED FORM VIEW
         Add Asset Management Smart Buttons
    ========================================================== -->

    <record id="view_hr_employee_asset_form_inherit"
            model="ir.ui.view">

        <field name="name">hr.employee.asset.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <!-- Add Smart Buttons -->
            <div name="button_box" position="inside">

                <!-- Assigned Assets -->
                <button name="action_view_assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-laptop"
                        groups="employee_asset_lifecycle_management.group_asset_employee">

                    <field name="asset_assignment_count"
                           widget="statinfo"
                           string="Assets Assigned"/>

                </button>

                <!-- Repair History -->
                <button name="action_view_repairs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        groups="employee_asset_lifecycle_management.group_asset_employee">

                    <field name="asset_repair_count"
                           widget="statinfo"
                           string="Repair History"/>

                </button>

            </div>

        </field>
    </record>

</odoo>
