<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Monthly Depreciation Recompute -->
        <record id="cron_asset_depreciation" model="ir.cron">
            <field name="name">Asset: Compute Monthly Depreciation</field>
            <field name="model_id" ref="model_asset_asset"/>
            <field name="state">code</field>
            <field name="code">model.cron_compute_depreciation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>

